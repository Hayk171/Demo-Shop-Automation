{
  // How the suite reaches the system by default.
  //   Gateway = everything through Ocelot on port 5000, the way real clients call it.
  //   Direct  = each service on its own port, useful when you need to know whether a failure
  //             is the gateway's or the service's.
  //
  // Gateway is the default because that is the supported entry point. The per-service URLs
  // below are still required: a few tests force one mode explicitly to prove the gateway and
  // the service behave differently, and Direct is the fastest way to isolate a failure.
  //
  // Override for a whole run without editing this file:  SHOP_TEST_Target=Direct
  "Target": "Gateway",

  "Services": {
    "Gateway": "http://localhost:5000",
    "Product": "http://localhost:5001",
    "Customer": "http://localhost:5002",
    "Order": "http://localhost:5003"
  },

  "Keycloak": {
    "BaseUrl": "http://localhost:8081",
    "Realm": "shop",
    "ClientId": "shop-test-client",
    "Audience": "shop-api",
    "Users": {
      "Admin": { "Username": "admin1", "Password": "Passw0rd!" },
      "Customer": { "Username": "alice", "Password": "Passw0rd!" }
    }
  },

  "RequestTimeoutMs": 30000
}
